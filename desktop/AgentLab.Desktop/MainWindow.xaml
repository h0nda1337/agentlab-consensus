<Window x:Class="AgentLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AgentLab Consensus" Width="1180" Height="840" MinWidth="1020" MinHeight="730" Background="#0C1525" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid Background="#0C1525" TextElement.Foreground="{StaticResource Ink}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#111E32" BorderBrush="#26344C" BorderThickness="0,0,1,0">
   <Grid Margin="22,30,18,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="◉  AGENTLAB" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" /><TextBlock Text="C O N S E N S U S" FontSize="10" Margin="30,7,0,32" Foreground="{StaticResource Muted}" /></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="SetupNav" Content="01   Configuración" HorizontalContentAlignment="Left" Margin="0,0,0,10" Click="ShowSetup" /><Button x:Name="RepairNav" Content="02   Nueva reparación" Margin="0,0,0,10" Click="ShowRepair" /><Button x:Name="ActivityNav" Content="03   Actividad" Margin="0,0,0,10" Click="ShowActivity" /></StackPanel>
    <Border Grid.Row="3" BorderBrush="#31435F" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="UN EQUIPO. UN OBJETIVO." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><TextBlock Text="Implementar, revisar y probar. Cada cambio necesita tres votos." Style="{StaticResource Hint}" /><TextBlock Text="Local · Python + WSL" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,26,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Prepara tu equipo" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="De la primera conexión al primer arreglo, paso a paso." Style="{StaticResource Hint}" Margin="0,6,15,0" /></StackPanel><Border Grid.Column="1" Background="#183A39" CornerRadius="12" Padding="12,7" VerticalAlignment="Top"><TextBlock x:Name="StatusBadge" Text="CONFIGURACIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" /></Border></Grid>

   <Grid x:Name="SetupPage" Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <UniformGrid Columns="4" Margin="0,0,0,20"><Button x:Name="Step0" Tag="0" Content="1 · Equipo" Click="GoStep" /><Button x:Name="Step1" Tag="1" Content="2 · Modelos" Click="GoStep" /><Button x:Name="Step2" Tag="2" Content="3 · Entorno" Click="GoStep" /><Button x:Name="Step3" Tag="3" Content="4 · Listo" Click="GoStep" /></UniformGrid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
     <Grid>
      <StackPanel x:Name="TeamStep">
       <TextBlock Text="Ponles el nombre que quieras" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Los roles se mantienen. Los nombres aparecerán en la discusión, los votos y los resultados." Style="{StaticResource Hint}" />
       <ItemsControl x:Name="TeamCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8,12,16" Padding="16"><StackPanel><TextBlock Text="●" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,2,0,20" /><TextBlock Text="{Binding role}" FontWeight="SemiBold" /><TextBlock Text="Nombre del agente" Style="{StaticResource Hint}" Margin="0,10,0,0" /><TextBox Text="{Binding name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Nombre del agente" /><TextBlock Text="{Binding role_hint}" Style="{StaticResource Hint}" FontSize="12" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Colaboración con evidencia" FontWeight="SemiBold" /><TextBlock Text="Todos comparten el objetivo y los resultados reales. Un desacuerdo devuelve la propuesta al equipo. El trabajo solo termina con pruebas correctas y aprobación unánime." Style="{StaticResource Hint}" Margin="0,8,0,0" /></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ModelsStep" Visibility="Collapsed">
       <TextBlock Text="Conecta tus modelos" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Se requieren servidores llama.cpp con chat y gramática GBNF. Los modelos se eligen por separado; el asistente no descarga pesos." Style="{StaticResource Hint}" />
       <WrapPanel><RadioButton x:Name="ExistingServers" Content="Ya tengo servidores" IsChecked="True" GroupName="Loading" Checked="LoadingChanged" /><RadioButton x:Name="LocalModels" Content="Cargar GGUF por turnos" GroupName="Loading" Checked="LoadingChanged" /></WrapPanel>
       <StackPanel x:Name="LlamaPathPanel" Visibility="Collapsed"><TextBlock Text="llama-server.exe" /><DockPanel><Button DockPanel.Dock="Right" Content="Buscar…" Margin="8,6,0,10" Click="BrowseLlama" /><TextBox x:Name="LlamaPath" AutomationProperties.Name="Ruta de llama-server.exe" /></DockPanel><TextBlock Text="Un modelo residente cada vez. Menos RAM; cada turno puede tardar en cargar." Style="{StaticResource Hint}" /></StackPanel>
       <ItemsControl x:Name="EndpointCards"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding name}" FontWeight="SemiBold" /><TextBlock Text="{Binding role}" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="URL base (sin /v1)" FontSize="12" /><TextBox Text="{Binding url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="URL base del servidor" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Plantilla del modelo" FontSize="12" /><ComboBox SelectedValue="{Binding family}" SelectedValuePath="Tag" AutomationProperties.Name="Plantilla del modelo"><ComboBoxItem Content="Nativa del GGUF" Tag="native" /><ComboBoxItem Content="Gemma 2" Tag="gemma2" /></ComboBox></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <ItemsControl x:Name="LocalCards" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="{Binding name}" FontWeight="SemiBold" /><DockPanel><Button DockPanel.Dock="Right" Content="Buscar GGUF…" Tag="{Binding}" Margin="8,6,0,10" Click="BrowseModel" /><TextBox Text="{Binding model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Archivo del modelo GGUF" /></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Dispositivo (Vulkan0, CUDA0, none = CPU)" FontSize="12" /><TextBox Text="{Binding device, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Plantilla del modelo" FontSize="12" /><ComboBox SelectedValue="{Binding family}" SelectedValuePath="Tag"><ComboBoxItem Content="Nativa del GGUF" Tag="native" /><ComboBoxItem Content="Gemma 2" Tag="gemma2" /></ComboBox></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel x:Name="EnvironmentStep" Visibility="Collapsed">
       <TextBlock Text="Elige dónde trabajar" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Podrás cambiar de entorno en cada reparación." Style="{StaticResource Hint}" />
       <Border Style="{StaticResource Card}"><StackPanel><RadioButton x:Name="PreferFolder" Content="Comenzar con una carpeta" GroupName="Environment" IsChecked="True" /><TextBlock Text="El equipo trabaja en una copia. Puedes conservarla para revisarla o aplicar los cambios al original después de las pruebas y los tres votos. Los comandos usan los permisos de tu usuario." Style="{StaticResource Hint}" Margin="22,0,0,0" /></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><RadioButton x:Name="PreferWsl" Content="Linux dedicado con WSL" GroupName="Environment" /><TextBlock Text="Acceso root a todo su Linux. Los cambios son directos y se conservan aunque una prueba falle. Se desactiva la integración habitual con Windows; WSL con root no es una VM de seguridad." Style="{StaticResource Hint}" Margin="22,0,0,12" /><TextBlock Text="Nombre del WSL administrado" /><TextBox x:Name="DistroName" Text="AgentLab-Repair" /><Button x:Name="PrepareWslButton" Content="Preparar este WSL" HorizontalAlignment="Left" Click="PrepareWsl" /><TextBlock Text="Descarga Debian y herramientas si faltan. Solo admite distribuciones AgentLab-* preparadas por el instalador." Style="{StaticResource Hint}" Margin="0,12,0,0" /></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="FinishStep" Visibility="Collapsed">
       <TextBlock Text="Tu equipo, a un paso" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Guarda los ajustes y comprueba las conexiones. La comprobación no inicia modelos locales." Style="{StaticResource Hint}" />
       <Border Style="{StaticResource Card}"><TextBlock x:Name="SetupSummary" LineHeight="28" /></Border>
       <TextBlock Text="Archivo de configuración" FontWeight="SemiBold" /><TextBlock x:Name="ConfigLocation" Style="{StaticResource Hint}" /><TextBlock Text="Se conservan tus ajustes adicionales y se crea un respaldo al guardar sobre una configuración existente." Style="{StaticResource Hint}" />
       <WrapPanel Margin="0,12,0,12"><Button x:Name="SaveButton" Content="Guardar configuración" Style="{StaticResource Primary}" Click="SaveSettings" /><Button x:Name="CheckButton" Content="Comprobar guardado" Click="CheckSettings" /></WrapPanel>
       <TextBox x:Name="CheckReport" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto" Text="Aún no se ha ejecutado una comprobación." />
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="StepLabel" Text="PASO 1 DE 4" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Atrás" Click="PreviousStep" /><Button x:Name="NextButton" Content="Continuar →" Style="{StaticResource Primary}" Click="NextStep" /></StackPanel></DockPanel>
   </Grid>

   <ScrollViewer x:Name="RepairPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Destino del equipo" FontSize="18" FontWeight="SemiBold" /><WrapPanel><RadioButton x:Name="RepairFolder" Content="Copia de una carpeta" GroupName="RepairMode" IsChecked="True" Checked="RepairModeChanged" /><RadioButton x:Name="RepairWsl" Content="WSL · acceso root" GroupName="RepairMode" Checked="RepairModeChanged" /></WrapPanel><DockPanel><Button x:Name="FolderBrowseButton" DockPanel.Dock="Right" Content="Elegir carpeta…" Margin="8,6,0,10" Click="BrowseFolder" /><TextBox x:Name="TargetPath" AutomationProperties.Name="Carpeta o ruta Linux del proyecto" /></DockPanel><TextBlock x:Name="TargetHint" Text="El equipo reparará una copia. El original solo cambia si marcas aplicar y la sesión termina verificada." Style="{StaticResource Hint}" Margin="0,0,0,0" /><CheckBox x:Name="ApplyChanges" Content="Aplicar al original después de pruebas y aprobación unánime" /><StackPanel x:Name="RepairDistroPanel" Visibility="Collapsed"><TextBlock Text="Distribución dedicada" /><TextBox x:Name="RepairDistro" Text="AgentLab-Repair" /></StackPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="¿Qué deben resolver juntos?" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Describe el comportamiento incorrecto y el resultado que esperas." Style="{StaticResource Hint}" /><TextBox x:Name="Objective" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Objetivo de la reparación" /><TextBlock Text="Comando que demuestra que el arreglo funciona" /><TextBox x:Name="TestCommand" Text="python -m unittest discover -s tests -v" AutomationProperties.Name="Comando de pruebas" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Máximo de propuestas (1–500)" FontSize="12" /><TextBox x:Name="MaxSteps" Text="36" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Segundos por comando (1–3600)" FontSize="12" /><TextBox x:Name="CommandTimeout" Text="120" /></StackPanel></Grid></StackPanel></Border>
    <Button x:Name="StartButton" Content="Iniciar reparación en equipo →" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="StartRepair" />
   </StackPanel></ScrollViewer>

   <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock x:Name="SessionTitle" Text="El equipo está en espera" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="SessionDescription" Text="Las propuestas, votos y pruebas aparecerán aquí al iniciar una reparación." Style="{StaticResource Hint}" Margin="0,6,0,0" /></StackPanel></Border><TextBox x:Name="ActivityLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="#080F1C" Foreground="#BBD0E8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" /><WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="StopButton" Content="Solicitar parada" IsEnabled="False" Click="StopRepair" /><Button x:Name="OpenResultsButton" Content="Abrir resultados" IsEnabled="False" Click="OpenResults" /></WrapPanel></Grid>
   <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="PythonButton" DockPanel.Dock="Right" Content="Elegir Python" FontSize="11" Padding="9,5" Margin="12,0,0,0" Click="ChoosePython" /><TextBlock x:Name="Footer" Text="Configura primero. Comprueba las conexiones. Luego elige un objetivo." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" MaxHeight="64" TextTrimming="CharacterEllipsis" /></DockPanel>
  </Grid>
 </Grid>
</Window>
